#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1 && tput clear 2>/dev/null; then return 0; fi
  printf '\033[2J\033[3J\033[H'
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else false; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any, with write_env's single
# quotes or a plain dotenv double-quoted value undone.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line value sq="'\\''"; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  value="${line#*=}"
  if [[ "$value" == \'*\' ]]; then value="${value:1:${#value}-2}"; value="${value//"$sq"/\'}"
  elif [[ "$value" == \"*\" ]]; then
    value="${value:1:${#value}-2}"
    [[ "$value" == *[\\\$\"]* ]] && return 1   # escapes, $ or ": can't decode safely; ask again
  fi
  printf '%s' "$value"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret), edited
# with Readline. Fails at EOF with no input.
ask() {
  local key="$1" prompt="$2" current input s=$'\001' e=$'\002' p rc=0
  current=$(_existing "$key" || true)
  # Readline needs the colour codes wrapped in \001..\002 to place the cursor.
  p="  $s$BOLD$e$prompt$s$RESET$e "
  [[ -n "$current" ]] && p+="$s$DIM$e[Enter keeps current]$s$RESET$e "
  read -e -r -p "$p" input || rc=1
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input rc=0
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || rc=1
  printf '\n'
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY='VALUE' into ENV_FILE (replaces any existing
# line) and sets $KEY. Idempotent. Creates ENV_FILE at mode 0600; writes through
# a symlink and keeps an existing file's mode.
write_env() {
  local key="$1" value="$2" tmp sq="'\\''"
  [[ -e "$ENV_FILE" ]] || (umask 077 && : > "$ENV_FILE")
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf "%s='%s'\n" "$key" "${value//\'/$sq}" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"
  rm -f "$tmp"
  printf -v "$key" '%s' "$value"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# Keep every stage inside run_wizard and the last line as is: bash then parses
# the whole file before the first prompt, so an edit mid-run can't break it.
# ──────────────────────────────────────────────────────────────────────────


# Owner-only hosting setup for #7: Vercel project, Neon, secrets, GitHub
# Environments. Dashboard wording is from the docs as of 2026-11; where a
# label differs, follow the intent in the step.

PROJECT=my-finance          # production.rb's config.hosts expects this name
VERCEL_CLI=vercel@65.14.0   # same pin as .github/workflows/deploy.yml

cd "$(dirname "$0")/.."

vc() { npx --yes "$VERCEL_CLI" "$@"; }

# set_env_secret ENVIRONMENT NAME VALUE sets a GitHub Environment secret.
set_env_secret() {
  if printf '%s' "$3" | gh secret set "$2" --env "$1" >/dev/null; then
    WRITTEN_SECRET+=("$1/$2")
    printf '  %s✓ set%s GitHub secret %s in environment %s\n' "$GREEN" "$RESET" "$2" "$1"
  else
    SKIPPED+=("GitHub secret $2 in environment $1 (gh secret set $2 --env $1)")
    warn "couldn't set $2 in environment $1; set it later"
  fi
}

# set_vercel_env ENVIRONMENT NAME VALUE adds a sensitive Vercel env var, replacing any old one.
set_vercel_env() {
  if printf '%s' "$3" | vc env add "$2" --environment "$1" --sensitive --force --yes >/dev/null; then
    printf '  %s✓ set%s Vercel %s %s\n' "$GREEN" "$RESET" "$1" "$2"
  else
    SKIPPED+=("Vercel $1 env var $2 (Project → Settings → Environment Variables)")
    warn "couldn't set Vercel $1 $2; add it in the dashboard"
  fi
}

# ask_db_url KEY "Prompt" pooled|direct asks until the URL matches the kind:
# Neon's pooled host carries -pooler, the direct one doesn't.
ask_db_url() {
  local key="$1" prompt="$2" kind="$3" value
  while true; do
    ask_secret "$key" "$prompt"
    value="${!key}"
    if [[ "$value" != postgres* ]]; then warn "that isn't a postgres:// URL"; continue; fi
    if [[ "$kind" == pooled && "$value" != *-pooler.* ]]; then warn "expected a pooled URL (host contains -pooler)"; continue; fi
    if [[ "$kind" == direct && "$value" == *-pooler.* ]]; then warn "expected a direct URL (no -pooler in the host)"; continue; fi
    return 0
  done
}

# github_environment NAME BRANCH creates the Environment, deployable only from BRANCH.
github_environment() {
  gh api -X PUT "repos/{owner}/{repo}/environments/$1" \
    -F 'deployment_branch_policy[protected_branches]=false' \
    -F 'deployment_branch_policy[custom_branch_policies]=true' >/dev/null
  gh api -X POST "repos/{owner}/{repo}/environments/$1/deployment-branch-policies" \
    -f name="$2" -f type=branch >/dev/null 2>&1 || true   # already there on a re-run
  printf '  %s✓ environment%s %s (deploys from %s only)\n' "$GREEN" "$RESET" "$1" "$2"
}

run_wizard() {

TOTAL_STAGES=7

banner "Hosting setup: Vercel + Neon + GitHub Actions"

stage "Check your tools"
say "You need the GitHub CLI and the Vercel CLI, both logged in as you."
gh auth status >/dev/null 2>&1 || { warn "gh isn't logged in: run 'gh auth login', then re-run."; exit 1; }
say "gh is logged in. Checking Vercel (runs $VERCEL_CLI via npx)…"
vc whoami >/dev/null 2>&1 || vc login
note "Logged in to Vercel as $(vc whoami 2>/dev/null)."
pause

stage "Vercel project (Services, fra1, no Git)"
say "Creates the project '$PROJECT' and links this folder to it (.vercel/, gitignored)."
note "vercel.json already sets the services, region fra1 and git.deploymentEnabled false."
if confirm "Create the Vercel project '$PROJECT' now?"; then
  vc project add "$PROJECT" || note "It may already exist; linking to it next."
fi
vc link --yes --project "$PROJECT"
open_url "https://vercel.com/dashboard"
step "Open the project '$PROJECT' → Settings → Git. Leave it with no repository connected."
note "No region to pick: vercel.json pins fra1, and the first deploy shows it under Settings → Functions."
pause "Done?"

stage "Neon database from the Vercel Marketplace"
open_url "https://vercel.com/marketplace/neon"
step "Install Neon, then create a database: region AWS eu-central-1 (Frankfurt), Free plan."
step "Connect it to the project '$PROJECT' with Production only: untick Development and Preview."
step "Leave 'create a database branch for each Preview deployment' unticked (ADR 0013)."
note "This writes the pooled DATABASE_URL into Vercel's Production environment for you."
pause "Done?"

stage "Neon branch 'dev' for previews"
step "From the project's Storage tab, open the database in the Neon Console."
step "Branches → New branch: name 'dev', parent the default (production) branch."
step "On 'dev', Connect → keep 'Connection pooling' on → copy the connection string."
ask_db_url PREVIEW_POOLED_URL "Paste the 'dev' branch POOLED URL:" pooled
set_vercel_env preview DATABASE_URL "$PREVIEW_POOLED_URL"
step "Same dialog, turn 'Connection pooling' off → copy the direct string for 'dev'."
ask_db_url PREVIEW_DIRECT_URL "Paste the 'dev' branch DIRECT URL:" direct
step "Switch the dialog to the production branch, pooling off → copy its direct string."
ask_db_url PRODUCTION_DIRECT_URL "Paste the production branch DIRECT URL:" direct
note "The direct URLs go to GitHub in the last stage; CI migrates over them."
pause

stage "SECRET_KEY_BASE for Production and Preview"
say "Generates a separate random key for each environment and stores it in Vercel."
warn "Replacing an existing key signs everyone out of that environment."
if confirm "Set (or replace) SECRET_KEY_BASE for Production and Preview?"; then
  set_vercel_env production SECRET_KEY_BASE "$(openssl rand -hex 64)"
  set_vercel_env preview SECRET_KEY_BASE "$(openssl rand -hex 64)"
fi
pause

stage "Vercel token for GitHub Actions"
open_url "https://vercel.com/account/settings/tokens"
step "Create Token: name 'github-actions-$PROJECT', scope the team that owns '$PROJECT'."
step "Pick an expiry you'll remember to rotate, then copy the token."
ask_secret VERCEL_TOKEN "Paste the Vercel token:"
set_secret VERCEL_TOKEN "$VERCEL_TOKEN"
set_secret VERCEL_ORG_ID "$(ruby -rjson -e 'print JSON.parse(File.read(".vercel/project.json"))["orgId"]')"
set_secret VERCEL_PROJECT_ID "$(ruby -rjson -e 'print JSON.parse(File.read(".vercel/project.json"))["projectId"]')"
pause

stage "GitHub Environments: preview and production"
say "Creates both environments; each may deploy only from its branch."
github_environment preview dev
github_environment production main
set_env_secret preview DATABASE_URL_UNPOOLED "$PREVIEW_DIRECT_URL"
set_env_secret production DATABASE_URL_UNPOOLED "$PRODUCTION_DIRECT_URL"
say "Next: the next push to dev deploys the preview, a push to main deploys prod."
say "Then measure prod: bin/measure-hosting https://$PROJECT.vercel.app"
pause

finish
}

run_wizard "$@"; exit
