#!/usr/bin/env ruby
# Usage: bin/measure-hosting <prod URL> [warm requests, default 50]
# The prod URL is the one bin/setup-hosting printed. For a protected preview,
# export VERCEL_AUTOMATION_BYPASS_SECRET first; it is sent as a header, never printed.
require_relative "../api/script/hosting_measurement"

base_url = ARGV[0] or abort "Usage: bin/measure-hosting <prod URL> [warm requests]"
warm_count = Integer(ARGV.fetch(1, "50"), exception: false) or abort "warm requests must be a whole number"
begin
  HostingMeasurement.run(base_url, warm_count, bypass_secret: ENV["VERCEL_AUTOMATION_BYPASS_SECRET"])
rescue ArgumentError => e
  abort e.message
end
