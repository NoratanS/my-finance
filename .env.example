# Copy to `.env` and adjust. Every variable has a working default in
# docker-compose.yml, so a `.env` file is optional for local use — but set a
# real POSTGRES_PASSWORD for anything beyond a throwaway instance.

# Database name, user, and password. The backend receives matching
# DB_URL / DB_USERNAME / DB_PASSWORD automatically — configure only these.
POSTGRES_DB=myfinance
POSTGRES_USER=myfinance
POSTGRES_PASSWORD=change-me

# Set to true when serving the app over HTTPS: the session cookie is then
# only ever sent over TLS. Must stay false for plain-HTTP localhost use.
SESSION_COOKIE_SECURE=false

# Password for the read-only `myfinance_ro` database role that the analytics
# service connects with. The V4 migration creates the role with this password,
# so it is one value used in two places — change it here only.
DB_ANALYTICS_PASSWORD=change-me

# Shared secret the backend sends to the analytics service, which publishes no
# port. Defense in depth rather than the only barrier.
ANALYTICS_TOKEN=change-me

# Optional local AI (start it with `docker compose --profile ai up -d`).
# The model is downloaded on first use into the `ollama-models` volume —
# about 2.5 GB for the default — and reused after that. Any tag from
# https://ollama.com/library works; the default was chosen by benchmark
# (see analytics/benchmarks/results.md).
OLLAMA_MODEL=qwen3:4b

# Where the analytics service looks for Ollama. Compose sets this for you; it is
# listed here because UNSETTING it is the switch that turns the AI layer off —
# analytics then reports interpret: false and the UI falls back to chips and
# templates, losing convenience and no capability.
OLLAMA_URL=http://ollama:11434

# Optional metrics (start with `docker compose --profile observability up -d`).
# Login for Grafana at http://localhost:3001 — only reachable from this machine.
GRAFANA_ADMIN_PASSWORD=change-me
