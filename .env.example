# Every setting the stack (docker-compose.yml) reads, with its default. Copy
# this file to `.env` and edit that copy; `docker compose up -d --build`
# applies the change. `.env` is git-ignored.

# Database name, user, and password. The backend receives matching
# DB_URL / DB_USERNAME / DB_PASSWORD automatically — configure only these.
# They take effect when the database volume is first created.
POSTGRES_DB=myfinance
POSTGRES_USER=myfinance
POSTGRES_PASSWORD=myfinance

# Password for the read-only `myfinance_ro` database role that the analytics
# service connects with. The V4 migration creates the role with this password
# on the first start, so it is one value used in two places — set it here only.
DB_ANALYTICS_PASSWORD=myfinance-ro

# Host address the published ports listen on. 127.0.0.1 = this computer only;
# 0.0.0.0 = every interface, so other devices on your network can reach it.
# With MYFINANCE_AUTH_MODE=none there is no sign-in at all: anyone who can
# reach the instance can read and delete everything. Keep 127.0.0.1 with it.
MYFINANCE_BIND_ADDRESS=127.0.0.1

# Sign-in mode. `password` (default): accounts with passwords. `none`: no login
# at all — one local account, for a single user on a machine they control.
# Switching none -> password: set a password in the app first.
MYFINANCE_AUTH_MODE=password

# Set to true when serving the app over HTTPS: the session cookie is then
# only ever sent over TLS. Must stay false for plain-HTTP localhost use.
SESSION_COOKIE_SECURE=false

# Time zone Insights use to decide what "today", "this month" and "last N
# months" mean — an IANA name such as Europe/Warsaw (default UTC). The
# subscription charge job and the subscriptions screen stay on UTC regardless.
# A misspelled name makes every insight fail ("the analytics service isn't
# running"). A TZ exported in your shell takes precedence over this line.
TZ=UTC
