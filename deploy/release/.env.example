# start.sh / start.bat copy this file to `.env` on first run and replace
# POSTGRES_PASSWORD with a random value. Edit `.env` (not this file) to
# change settings; restart with `docker compose up -d` to apply.

# Database name, user, and password. The backend receives matching
# DB_URL / DB_USERNAME / DB_PASSWORD automatically — configure only these.
POSTGRES_DB=myfinance
POSTGRES_USER=myfinance
POSTGRES_PASSWORD=change-me

# Set to true when serving the app over HTTPS: the session cookie is then
# only ever sent over TLS. Must stay false for plain-HTTP localhost use.
SESSION_COOKIE_SECURE=false
