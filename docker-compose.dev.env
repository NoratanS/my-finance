# Development default for the one setting deploy/release/docker-compose.yml
# requires instead of defaulting (C12). Not a template: to change a setting, copy
# deploy/release/.env.example to .env. It is the published development value,
# not a secret. Anything set in .env or the shell wins; an explicitly empty
# ANALYTICS_TOKEN stops the stack, as it does in the release. Keep it to this one
# line: the release file already defaults every other setting.
ANALYTICS_TOKEN=dev-analytics-token
