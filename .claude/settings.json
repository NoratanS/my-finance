{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh issue close*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo rename*)",
      "Bash(gh release*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)",
      "Bash(gh api -X PUT*)",
      "Bash(gh api --method PUT*)",
      "Bash(git push*--force*)",
      "Bash(git push*-f *)",
      "Bash(git push*--delete*)",
      "Bash(git push* main*)",
      "Bash(git push* dev*)",
      "Bash(git push*:main*)",
      "Bash(git push*:dev*)",
      "Bash(git merge*)"
    ]
  }
}
